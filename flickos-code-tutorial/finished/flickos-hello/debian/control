Source: flickos-hello
Section: utils
Priority: optional
Maintainer: Jon <dvbondoy@gmail.com>
# python3: the unit tests run while the package builds. They need no GTK.
Build-Depends: debhelper-compat (= 13),
               python3
Standards-Version: 4.7.0
Rules-Requires-Root: no

Package: flickos-hello
Architecture: all
# python3-gi, gir1.2-gtk-3.0: the window (show), GTK 3 so it follows the Arc
# theme. Everything else is the standard library.
Depends: python3,
         python3-gi,
         gir1.2-gtk-3.0,
         ${misc:Depends}
Description: says hello, with the greeting you choose (example package)
 The example program of FlickOS's tutorial on writing a program. It owns
 one setting, the greeting: a default for the computer in
 /etc/xdg/flickos/hello.conf, and each account's own choice, made on the
 command line or in a small window.
