@@ -0,0 +1,427 @@
+#!/usr/bin/python3
+"""Hello: greets you with the greeting you choose. The example program of
+FlickOS's tutorial on writing a program (~/Documents/flickos-code-tutorial).
+
+It owns one setting, the greeting. The machine's default is in the conffile
+/etc/xdg/flickos/hello.conf ([Hello] Greeting=ID); a user's choice is in
+~/.config/flickos/hello, written only when they choose one, and wins. A file
+that can't be read, or a greeting this version doesn't know, is warned about
+and ignored, so the program always starts. A greeting may be written as its id
+(mabuhay) or its text (Mabuhay): hello.conf 1.x held the text.
+
+Every change of the greeting is recorded for Settings → History
+(flickos-control), which shows it and undoes it with `greeting set OLD`.
+
+The window (show) is a plain GTK 3 window (python3-gi), so it follows the
+Arc-Dark or Arc theme of the chosen style, and it has no CSS of its own. GTK is
+imported only when the window opens, so the other commands work without a
+display. One window per session: a second show while it is open only says so
+(hello.lock in $XDG_RUNTIME_DIR/flickos). A greeting applies as soon as it is
+chosen; Escape or Close closes the window.
+
+Commands:
+  (none), say [NAME]      print the greeting to NAME (default: your user name)
+  show                    open the window
+  greeting list           print the greetings: id, text
+  greeting current        print the id of the greeting in use
+  greeting set ID|default choose a greeting (default: the machine's)
+
+Exit codes: 0 ok, 1 error, 2 usage error.
+"""
+
+import argparse
+import configparser
+import contextlib
+import datetime
+import fcntl
+import getpass
+import json
+import os
+import sys
+import tempfile
+import time
+
+NAME = "flickos-hello"
+APP_ID = "flickos-hello"            # Wayland app id, matches flickos-hello.desktop
+TITLE = "Hello"                     # the desktop file's Name (a test checks)
+ICON = "face-smile"                 # in Numix (Numix-Circle inherits it)
+# Testing hook (unit tests): a root to read /etc below.
+PREFIX = os.environ.get("FLICKOS_HELLO_PREFIX", "")
+SYSTEM_CONF = PREFIX + "/etc/xdg/flickos/hello.conf"
+SECTION = "Hello"
+KEY = "Greeting"
+# In $XDG_RUNTIME_DIR/flickos: held while the window is open (one per session).
+LOCK = "hello.lock"
+
+# Settings → History: every change of the greeting is one JSON line appended to
+# $XDG_STATE_HOME/flickos/history.jsonl, in the format every owner shares
+# (docs/design/flickos-history.md, ADR-002). History undoes a change by running
+# `greeting set OLD`.
+HISTORY_OWNER = NAME
+HISTORY_KEY = "greeting"            # the setting's name in the history
+HISTORY_FILE = "history.jsonl"      # in $XDG_STATE_HOME/flickos
+HISTORY_LOCK = "history.lock"
+HISTORY_BYTES = 256 * 1024          # above this, the older half is dropped
+# flickos-control's: [History] Enabled=, then the user's ~/.config/flickos/history.
+HISTORY_CONF = PREFIX + "/etc/xdg/flickos/history.conf"
+DEFAULT_CHOICE = "default"          # no choice of the user's: `greeting set default`, and in the history
+
+# The greetings, in the order they are listed: id (stored in the files, never
+# changed once shipped), text. Adding a greeting is adding a row.
+GREETINGS = [
+    ("hello", "Hello"),
+    ("hi", "Hi"),
+    ("mabuhay", "Mabuhay"),
+    ("howdy", "Howdy"),
+    ("good-day", "Good day"),
+]
+# When neither file sets one. The shipped hello.conf says the same (a test checks).
+DEFAULT_GREETING = "hello"
+
+
+def warn(message):
+    print(f"{NAME}: {message}", file=sys.stderr)
+
+
+def escape(text):
+    """Escape Pango markup in text shown with set_markup."""
+    return text.replace("&", "&amp;").replace("<", "&lt;").replace(">", "&gt;")
+
+
+# --- The setting -------------------------------------------------------------
+
+def config_home():
+    return os.environ.get("XDG_CONFIG_HOME") or os.path.join(os.path.expanduser("~"), ".config")
+
+
+def user_conf():
+    return os.path.join(config_home(), "flickos", "hello")
+
+
+def read_ini(path):
+    """The [Hello] keys of an INI file (lower-case names). A missing file is
+    empty; a broken one is empty with a warning."""
+    ini = configparser.ConfigParser(interpolation=None)
+    try:
+        ini.read(path, encoding="utf-8")
+    except (configparser.Error, UnicodeDecodeError) as error:
+        # configparser's messages run over several lines; the first says it.
+        warn(f"{path}: can't read it, ignored ({str(error).splitlines()[0].rstrip('.')})")
+        return {}
+    return dict(ini[SECTION]) if ini.has_section(SECTION) else {}
+
+
+def greeting_id(value, path):
+    """The id for a Greeting= value, given as an id or a text, any case, or
+    None (with a warning) when this version doesn't know it."""
+    wanted = value.strip().lower()
+    for greeting, text in GREETINGS:
+        if wanted in (greeting, text.lower()):
+            return greeting
+    warn(f"{path}: unknown greeting '{value.strip()}', ignored")
+    return None
+
+
+def system_greeting():
+    """The machine's greeting: hello.conf's, else DEFAULT_GREETING. What
+    `greeting set default` goes back to."""
+    value = read_ini(SYSTEM_CONF).get(KEY.lower())
+    return (value is not None and greeting_id(value, SYSTEM_CONF)) or DEFAULT_GREETING
+
+
+def user_greeting():
+    """The user's own choice, or None."""
+    value = read_ini(user_conf()).get(KEY.lower())
+    return greeting_id(value, user_conf()) if value is not None else None
+
+
+def current_greeting():
+    return user_greeting() or system_greeting()
+
+
+def greeting_text(greeting):
+    return dict(GREETINGS)[greeting]
+
+
+def write_atomic(path, text):
+    """Write text to path through a temporary file in the same folder, so no
+    one ever reads half a file. Raises OSError."""
+    folder = os.path.dirname(path)
+    os.makedirs(folder, exist_ok=True)
+    fd, tmp = tempfile.mkstemp(dir=folder, prefix=".", suffix=".tmp")
+    try:
+        with os.fdopen(fd, "w", encoding="utf-8") as f:
+            f.write(text)
+        os.chmod(tmp, 0o644)
+        os.replace(tmp, path)
+    except BaseException:
+        with contextlib.suppress(OSError):
+            os.unlink(tmp)
+        raise
+
+
+def save_greeting(greeting):
+    """Store the user's choice; None removes it, so the machine's applies again.
+    The file goes away when nothing is left in it. The change is recorded for
+    Settings → History. Raises OSError."""
+    path = user_conf()
+    old = user_greeting() or DEFAULT_CHOICE
+    if greeting is None:
+        with contextlib.suppress(FileNotFoundError):
+            os.unlink(path)
+    else:
+        write_atomic(path, f"# Written by {NAME}. Change it with: {NAME} greeting set ID|default\n"
+                           f"[{SECTION}]\n{KEY}={greeting}\n")
+    record(HISTORY_KEY, old, greeting or DEFAULT_CHOICE)
+
+
+# --- History -----------------------------------------------------------------
+
+def state_home():
+    return os.environ.get("XDG_STATE_HOME") or os.path.join(os.path.expanduser("~"), ".local", "state")
+
+
+def history_enabled():
+    """[History] Enabled= of the user's file, else the system's; on by default.
+    flickos-control owns the setting; every owner reads it the same way."""
+    enabled = True
+    for path in (HISTORY_CONF, os.path.join(config_home(), "flickos", "history")):
+        ini = configparser.ConfigParser(interpolation=None)
+        try:
+            ini.read(path, encoding="utf-8")
+            value = ini.get("History", "Enabled", fallback=None)
+        except (configparser.Error, UnicodeDecodeError):
+            continue
+        if value is not None:
+            enabled = value.strip().lower() not in ("no", "false", "off", "0")
+    return enabled
+
+
+def record(key, old, new):
+    """Add a change to the history. It never stops the change itself: a
+    history that can't be written is only a warning."""
+    if old == new or not history_enabled():
+        return
+    now = time.time_ns()
+    entry = {"v": 1, "id": str(now),
+             "time": datetime.datetime.fromtimestamp(now / 1e9).astimezone().isoformat(timespec="seconds"),
+             "owner": HISTORY_OWNER, "key": key, "old": old, "new": new}
+    folder = os.path.join(state_home(), "flickos")
+    try:
+        os.makedirs(folder, mode=0o700, exist_ok=True)
+        with open(os.path.join(folder, HISTORY_LOCK), "a") as lock:
+            fcntl.flock(lock, fcntl.LOCK_EX)
+            path = os.path.join(folder, HISTORY_FILE)
+            fd = os.open(path, os.O_WRONLY | os.O_APPEND | os.O_CREAT, 0o600)
+            with os.fdopen(fd, "a", encoding="utf-8") as f:
+                f.write(json.dumps(entry, ensure_ascii=False) + "\n")
+                size = os.fstat(f.fileno()).st_size
+            if size > HISTORY_BYTES:
+                trim_history(path)
+    except OSError as error:
+        warn(f"the history can't be written: {error}")
+
+
+def trim_history(path):
+    """Keep the newest lines that fit in half of HISTORY_BYTES (under the lock)."""
+    with open(path, encoding="utf-8", errors="replace") as f:
+        lines = f.readlines()
+    kept, size = [], 0
+    for line in reversed(lines):
+        size += len(line.encode())
+        if size > HISTORY_BYTES // 2:
+            break
+        kept.append(line)
+    fd, tmp = tempfile.mkstemp(dir=os.path.dirname(path), prefix=".", suffix=".tmp")
+    try:
+        with os.fdopen(fd, "w", encoding="utf-8") as f:
+            f.writelines(reversed(kept))
+        os.replace(tmp, path)
+    except BaseException:
+        with contextlib.suppress(OSError):
+            os.unlink(tmp)
+        raise
+
+
+# --- Single instance ---------------------------------------------------------
+
+@contextlib.contextmanager
+def single_instance():
+    """Yields True for the first window of the session, False while one is open.
+    Without XDG_RUNTIME_DIR there is nothing to share, so always True."""
+    base = os.environ.get("XDG_RUNTIME_DIR")
+    if not base:
+        yield True
+        return
+    folder = os.path.join(base, "flickos")
+    os.makedirs(folder, exist_ok=True)
+    with open(os.path.join(folder, LOCK), "a") as lock:
+        try:
+            fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
+        except BlockingIOError:
+            yield False
+            return
+        yield True
+
+
+# --- The window --------------------------------------------------------------
+
+def load_gtk():
+    """GTK 3, or None with a warning (not installed, or no display)."""
+    try:
+        import gi
+        gi.require_version("Gtk", "3.0")
+        gi.require_version("Gdk", "3.0")
+        from gi.repository import GLib
+        GLib.set_prgname(APP_ID)
+        from gi.repository import Gdk, Gtk
+    except (ImportError, ValueError) as error:
+        warn(f"can't open the window ({error}); python3-gi and gir1.2-gtk-3.0 are needed")
+        return None
+    if not Gtk.init_check(sys.argv[:1])[0]:
+        warn("can't open the window (no display)")
+        return None
+    return Gtk, Gdk
+
+
+def window(Gtk, Gdk):
+    """Build and show the window. Returns 0 when it is closed."""
+    name = getpass.getuser()
+    system = system_greeting()          # read once: it can't change while the window is open
+    win = Gtk.Window(title=TITLE, icon_name=ICON)
+    win.set_default_size(420, 220)
+    win.connect("destroy", Gtk.main_quit)
+
+    def key_pressed(_window, event):
+        """Escape closes the window: it has nothing to lose."""
+        if event.keyval == Gdk.KEY_Escape:
+            win.destroy()
+            return True
+        return False
+
+    win.connect("key-press-event", key_pressed)
+
+    outer = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=18)
+    outer.set_border_width(24)
+    win.add(outer)
+
+    # Not selectable: GTK focuses the first focusable widget, and a selectable
+    # label would open with its whole text selected.
+    big = Gtk.Label()
+    big.set_xalign(0)
+    outer.pack_start(big, False, False, 0)
+
+    def show_greeting():
+        text = f"{greeting_text(user_greeting() or system)}, {name}!"
+        big.set_markup(f"<span size='xx-large' weight='bold'>{escape(text)}</span>")
+
+    row = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=12)
+    label = Gtk.Label(label="_Greeting", use_underline=True)
+    combo = Gtk.ComboBoxText()
+    label.set_mnemonic_widget(combo)
+    # The first entry is the machine's greeting, stored as "no choice" (SET-8).
+    combo.append(DEFAULT_CHOICE, f"Default ({greeting_text(system)})")
+    for greeting, text in GREETINGS:
+        combo.append(greeting, text)
+    combo.set_active_id(user_greeting() or DEFAULT_CHOICE)
+    row.pack_start(label, False, False, 0)
+    row.pack_start(combo, False, False, 0)
+    outer.pack_start(row, False, False, 0)
+
+    problem = Gtk.Label(selectable=True, wrap=True)
+    problem.set_xalign(0)
+    problem.get_style_context().add_class("dim-label")
+    outer.pack_start(problem, False, False, 0)
+
+    def changed(box):
+        chosen = box.get_active_id()
+        try:
+            save_greeting(None if chosen == DEFAULT_CHOICE else chosen)
+        except OSError as error:
+            warn(f"{user_conf()}: {error}")
+            problem.set_text("Your greeting couldn't be saved. Check that your home "
+                             f"folder isn't full or read-only.\n{error}")
+            problem.show()
+            # Show what is really in use again, without saving it once more.
+            box.handler_block_by_func(changed)
+            box.set_active_id(user_greeting() or DEFAULT_CHOICE)
+            box.handler_unblock_by_func(changed)
+            return
+        problem.hide()
+        show_greeting()
+
+    combo.connect("changed", changed)
+
+    close = Gtk.Button.new_with_mnemonic("_Close")
+    close.connect("clicked", lambda _b: win.destroy())
+    close.set_halign(Gtk.Align.END)
+    outer.pack_end(close, False, False, 0)
+
+    show_greeting()
+    win.show_all()
+    problem.hide()
+    Gtk.main()
+    return 0
+
+
+# --- Commands ----------------------------------------------------------------
+
+def cmd_say(opts):
+    name = opts.name or getpass.getuser()
+    print(f"{greeting_text(current_greeting())}, {name}!")
+    return 0
+
+
+def cmd_show(_opts):
+    with single_instance() as first:
+        if not first:
+            print("Hello is already open.")
+            return 0
+        gtk = load_gtk()
+        if not gtk:
+            return 1
+        return window(*gtk)
+
+
+def cmd_list(_opts):
+    for greeting, text in GREETINGS:
+        print(f"{greeting}\t{text}")
+    return 0
+
+
+def cmd_current(_opts):
+    print(current_greeting())
+    return 0
+
+
+def cmd_set(opts):
+    try:
+        save_greeting(None if opts.value == DEFAULT_CHOICE else opts.value)
+    except OSError as error:
+        warn(f"can't save the greeting ({error})")
+        return 1
+    return 0
+
+
+def main(argv=None):
+    parser = argparse.ArgumentParser(prog=NAME, description="Say hello, with the greeting you choose.")
+    commands = parser.add_subparsers(dest="command", metavar="COMMAND")
+    say = commands.add_parser("say", help="print the greeting")
+    say.add_argument("name", nargs="?", help="who to greet (default: you)")
+    say.set_defaults(func=cmd_say)
+    commands.add_parser("show", help="open the window").set_defaults(func=cmd_show)
+    greeting = commands.add_parser("greeting", help="the greeting in use").add_subparsers(
+        dest="action", metavar="ACTION", required=True)
+    greeting.add_parser("list", help="print the greetings: id, text").set_defaults(func=cmd_list)
+    greeting.add_parser("current", help="print the id of the greeting in use").set_defaults(func=cmd_current)
+    setter = greeting.add_parser("set", help="choose a greeting")
+    setter.add_argument("value", choices=[g for g, _text in GREETINGS] + [DEFAULT_CHOICE])
+    setter.set_defaults(func=cmd_set)
+    opts = parser.parse_args(argv)
+    if not getattr(opts, "func", None):
+        opts.func, opts.name = cmd_say, None
+    return opts.func(opts)
+
+
+if __name__ == "__main__":
+    sys.exit(main())
