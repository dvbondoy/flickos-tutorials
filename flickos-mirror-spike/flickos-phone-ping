def cmd_pair(opts):
    """Wait for a phone to ask, show its key, answer. With --json: one JSON
    event per line (waiting, request, paired, refused, failed, timeout), and
    the answer, yes or no, is read as a line from standard input."""
    say = print_event if opts.json else None
    if not load_settings().enabled:
        raise PhoneError("the phone connection is off (flickos-phone set enabled yes)")
    try:
        conn = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
        conn.connect(control_path())
    except OSError:
        raise PhoneError("the phone connection isn't running") from None
    with conn:
        reply(conn, {"command": "pair"})
        event = read_json(conn, 10)
        if "error" in event:
            raise PhoneError(event["error"])
        if say:
            say(event)
        else:
            print(f'In the KDE Connect app on the phone, choose "{event["name"]}" and tap Pair.')
            if event.get("firewall"):
                print("The firewall is on: the phone can only connect if it lets phones in\n"
                      "(Settings > Phone, or flickos-control system firewall.phones on).")
            print(f"Waiting {PAIR_SECONDS // 60} minutes...")
        event = read_json(conn, PAIR_SECONDS + 30)
        if event.get("event") != "request":
            if say:
                say(event)
                return 1
            raise PhoneError("no phone asked to pair")
        if say:
            say(event)
            answer = sys.stdin.readline().strip().lower()
        else:
            print(f"{event['name']} asks to pair. Verification key: {event['key']}")
            answer = input("Does the phone show the same key? [y/N] ").strip().lower()
        reply(conn, {"answer": "yes" if answer in ("y", "yes") else "no"})
        event = read_json(conn, 10)
    if say:
        say(event)
        return 0 if event.get("event") == "paired" else 1
    if event.get("event") != "paired":
        raise PhoneError("not paired")
    print(f"Paired with {event['name']}.")
    return 0


def print_event(event):
    print(json.dumps(event, ensure_ascii=False), flush=True)


def cmd_send(opts):
    """Send to the phone. --notify (the file manager's Send to Phone, which
    shows no output, and is there even while the phone connection is off):
    say so with a notification while sending and after."""
    note = None
    shot = None
    try:
        items = []
        if opts.choose:
            chosen = choose_files()
            if not chosen:
                return 0                # cancelled
            items.extend({"kind": "file", "value": path} for path in chosen)
        if opts.type_text:
            typed = type_text()
            if not typed:
                return 0                # cancelled
            items.append({"kind": "text", "value": typed})
        if opts.screenshot:
            shot = take_screenshot()
            items.append({"kind": "file", "value": shot})
        if opts.clipboard:
            # A web address goes as a page, so the phone offers to open it.
            text = clipboard_text()
            address = text.strip()
            if "\n" not in address and web_address(address):
                items.append({"kind": "url", "value": address})
            else:
                items.append({"kind": "clipboard", "value": text})
        if opts.text is not None:
            items.append({"kind": "text", "value": opts.text})
        for thing in opts.things:
            if re.match(r"^[a-z][a-z0-9+.-]*://", thing, re.I):
                items.append({"kind": "url", "value": thing})
            elif os.path.isfile(thing):
                items.append({"kind": "file", "value": os.path.abspath(thing)})
            else:
                raise PhoneError(f"{thing}: not a file or an address")
        if not items:
            raise PhoneError("nothing to send")
        if opts.notify:
            note = progress_note("Sending to your phone…", sent_names(items))
        answer = request({"command": "send", "to": opts.to, "items": items})
        if answer is None:
            raise PhoneError(not_running_reason())
    except (PhoneError, OSError, ValueError) as error:
        if opts.notify:
            progress_note("Not sent to your phone", f"{str(error)[:1].upper()}{str(error)[1:]}.", note)
        raise
    finally:
        if shot:
            with contextlib.suppress(OSError):
                os.unlink(shot)
    print(f"Sent to {answer['name']}.")
    if opts.notify:
        progress_note(f"Sent to {answer['name']}", sent_names(items), note)
    return 0


def not_running_reason():
    """Why the daemon didn't answer, in words for a notification."""
    if live_session():
        return "phones can't connect in the live session"
    if not load_settings().enabled:
        return "the phone connection is off: turn it on in Settings > Phone"
    return "the phone connection isn't running"


def choose_files():
    """The files picked in GTK's file chooser; [] when it's cancelled. GTK is
    imported only here, so nothing else in this program needs it."""
    try:
        import gi
        gi.require_version("Gtk", "3.0")
        from gi.repository import Gtk
    except (ImportError, ValueError) as error:
        raise PhoneError(f"the file chooser needs GTK 3: {error}") from None
    dialog = Gtk.FileChooserDialog(title="Send Files to Phone", action=Gtk.FileChooserAction.OPEN)
    dialog.add_buttons("_Cancel", Gtk.ResponseType.CANCEL, "_Send", Gtk.ResponseType.ACCEPT)
    dialog.set_default_response(Gtk.ResponseType.ACCEPT)
    dialog.set_select_multiple(True)
    dialog.set_local_only(True)
    try:
        if dialog.run() != Gtk.ResponseType.ACCEPT:
            return []
        return [path for path in dialog.get_filenames() if os.path.isfile(path)]
    finally:
        dialog.destroy()
        while Gtk.events_pending():         # let the window go before sending
            Gtk.main_iteration()


def type_text():
    """A line typed into fuzzel (a box like the menu's, without a list);
    "" when it's cancelled."""
    if shutil.which("fuzzel") is None:
        raise PhoneError("fuzzel is not installed")
    result = subprocess.run(["fuzzel", "--dmenu", "--prompt-only", "Text to send: "],
                            stdin=subprocess.DEVNULL, capture_output=True, text=True, check=False)
    return result.stdout.strip() if result.returncode == 0 else ""


def take_screenshot():
    """The whole screen as a PNG in the runtime folder (deleted after sending)."""
    if shutil.which("grim") is None:
        raise PhoneError("grim is not installed")
    # The menu that asked for it has just closed: let it leave the screen.
    time.sleep(SCREENSHOT_DELAY)
    folder = runtime_dir()
    os.makedirs(folder, mode=0o700, exist_ok=True)
    path = os.path.join(folder, datetime.datetime.now().strftime("Screenshot %Y-%m-%d %H-%M-%S.png"))
    try:
        result = subprocess.run(["grim", path], capture_output=True, text=True, timeout=30)
    except (OSError, subprocess.TimeoutExpired) as error:
        raise PhoneError(f"grim: {error}") from None
    if result.returncode != 0 or not os.path.isfile(path):
        raise PhoneError(f"the screenshot failed: {result.stderr.strip() or 'grim gave nothing'}")
    return path


def cmd_ping(opts):
    """SPIKE: send a ping with TEXT; the phone shows it as a notification."""
    answer = request({"command": "ping", "to": opts.to, "text": opts.text}, timeout=10)
    if answer is None:
        raise PhoneError("the phone connection isn't running")
    print(f"pinged {answer['name']}")


def cmd_stop(opts):
    """SPIKE: stop the running daemon (installed or this copy), keep its state."""
    answer = request({"command": "stop"}, timeout=10)
    print("stopped" if answer else "no daemon was running")


def cmd_ring(opts):
    """Ring the phone, even when it's silenced, until it's picked up."""
    try:
        answer = request({"command": "ring", "to": opts.to}, timeout=10)
        if answer is None:
            raise PhoneError("the phone connection isn't running")
    except (PhoneError, OSError, ValueError) as error:
        if opts.notify:
            progress_note("Your phone can't ring", f"{str(error)[:1].upper()}{str(error)[1:]}.")
        raise PhoneError(str(error)) from None
    print(f"{answer['name']} is ringing.")
    if opts.notify:
        progress_note(f"{answer['name']} is ringing", "Tap it on the phone to stop it.")
    return 0


def sent_names(items):
    names = [os.path.basename(i["value"]) if i["kind"] == "file" else
             "the clipboard" if i["kind"] == "clipboard" else i["value"][:60] for i in items]
    return ", ".join(names[:3]) + (f" and {len(names) - 3} more" if len(names) > 3 else "")


def progress_note(title, body, replace=None):
    """A notification that replaces the one with id replace; its id."""
    argv = ["notify-send", "--app-name=Phone", "--icon=phone", "--print-id", title, body]
    if replace:
        argv.insert(1, f"--replace-id={replace}")
    try:
        result = subprocess.run(argv, capture_output=True, text=True, timeout=10)
    except (OSError, subprocess.TimeoutExpired):
        return replace
    return result.stdout.strip() or replace


def cmd_received(opts):
    items = read_received()
    if opts.json:
        print(json.dumps(items, ensure_ascii=False))
        return 0
    for item in items:
        when = datetime.datetime.fromtimestamp(item["time"]).strftime("%Y-%m-%d %H:%M")
        print(f"{when}\t{item['device']}\t{item['kind']}\t{item['value']}")
    return 0


def cmd_network(opts):
    settings = load_settings()
    if opts.action == "list":
        names, active = network_names(), active_networks() or []
        for uuid_ in settings.networks:
            here = "\tthis network" if uuid_ in active else ""
            print(f"{names.get(uuid_, '?')}\t{uuid_}{here}")
        return 0
    if opts.action == "add":
        added = [opts.uuid] if opts.uuid else (active_networks() or [])
        if not added:
            raise PhoneError("not connected to a Wi-Fi or wired network")
        networks = tuple(dict.fromkeys(settings.networks + tuple(added)))
    else:
        if not opts.uuid:
            raise PhoneError("network remove UUID")
        networks = tuple(n for n in settings.networks if n != opts.uuid)
    save_settings(networks=networks)
    with contextlib.suppress(PhoneError, OSError, ValueError):
        request({"command": "reload"}, timeout=10)
    return 0


def main(argv=None):
    parser = argparse.ArgumentParser(prog="flickos-phone",
                                     description="Send pages, files and text between a phone and this computer.")
    commands = parser.add_subparsers(dest="command", required=True, metavar="COMMAND")
    commands.add_parser("daemon", help="the session daemon (autostart; only while on)").set_defaults(func=cmd_daemon)
    get = commands.add_parser("get", help="print a setting: enabled, name, networks")
    get.add_argument("key", choices=("enabled", "name", "networks"))
    get.set_defaults(func=cmd_get)
    set_ = commands.add_parser("set", help="enabled yes|no|default, name NAME|default, "
                               "networks 'UUID ...'|default")
    set_.add_argument("key", choices=("enabled", "name", "networks"))
    set_.add_argument("value")
    set_.set_defaults(func=cmd_set)
    status = commands.add_parser("status", help="on or off, running, connected phones")
    status.add_argument("--json", action="store_true")
    status.add_argument("--panel", action="store_true", help="the panel button's JSON (waybar)")
    commands.add_parser("menu", help="the panel button's menu (fuzzel)").set_defaults(func=cmd_menu)
    ping = commands.add_parser("ping", help="SPIKE: a notification on the phone")
    ping.add_argument("text", nargs="?")
    ping.add_argument("--to", metavar="ID")
    ping.set_defaults(func=cmd_ping)
    commands.add_parser("stop", help="SPIKE: stop the daemon").set_defaults(func=cmd_stop)
    ring = commands.add_parser("ring", help="ring the phone, even when it's silenced")
    ring.add_argument("--to", metavar="ID", help="the phone, when more than one is connected")
    ring.add_argument("--notify", action="store_true", help="say what happened in a notification")
    ring.set_defaults(func=cmd_ring)
    status.set_defaults(func=cmd_status)
    devices = commands.add_parser("devices", help="paired phones: name, id, connected")
    devices.add_argument("--json", action="store_true")
    devices.set_defaults(func=cmd_devices)
    pair = commands.add_parser("pair", help="let a phone pair: wait for it to ask, show its key")
    pair.add_argument("--json", action="store_true", help="events as JSON lines, the answer on stdin")
    pair.set_defaults(func=cmd_pair)
    commands.add_parser("state", help="everything the Settings page shows, as JSON").set_defaults(func=cmd_state)
    forget = commands.add_parser("forget", help="forget a paired phone")
    forget.add_argument("id")
    forget.set_defaults(func=cmd_forget)
    send = commands.add_parser("send", help="send files or addresses to the phone")
    send.add_argument("things", nargs="*", metavar="FILE|URL")
    send.add_argument("--to", metavar="ID", help="the phone, when more than one is connected")
    send.add_argument("--text", help="send this text")
    send.add_argument("--clipboard", action="store_true",
                      help="send the clipboard's text (a web address goes as a page)")
    send.add_argument("--screenshot", action="store_true", help="send a screenshot of the whole screen")
    send.add_argument("--choose", action="store_true", help="choose the files in a window")
    send.add_argument("--type-text", action="store_true", help="type the text to send in a box")
    send.add_argument("--notify", action="store_true", help="say what happened in a notification "
                      "(the file manager's Send to Phone)")
    send.set_defaults(func=cmd_send)
    received = commands.add_parser("received", help="what came from a phone recently")
    received.add_argument("--json", action="store_true")
    received.set_defaults(func=cmd_received)
    network = commands.add_parser("network", help="the networks where it listens: list, add [UUID], remove UUID")
    network.add_argument("action", choices=("list", "add", "remove"))
    network.add_argument("uuid", nargs="?")
    network.set_defaults(func=cmd_network)
    opts = parser.parse_args(argv)
    try:
        return opts.func(opts)
    except (PhoneError, OSError, ValueError) as error:
        warn(str(error))
        return 1
    except (KeyboardInterrupt, EOFError):
        return 1


if __name__ == "__main__":
    sys.exit(main())
