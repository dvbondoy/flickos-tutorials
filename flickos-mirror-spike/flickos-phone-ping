def cmd_set(opts):
    key, value = opts.key, opts.value
    if key == "enabled":
        was = load_settings().enabled
        if value == DEFAULT_CHOICE:
            on = system_settings().enabled
            save_settings(enabled=None)
        elif value in ("yes", "no"):
            on = value == "yes"
            if on and live_session():
                raise PhoneError("not available in the live session")
            save_settings(enabled=on)
        else:
            raise PhoneError("enabled: yes, no or default")
        if on:
            ensure_identity()
            if request({"command": "status"}) is None:
                start_daemon()
        else:
            with contextlib.suppress(PhoneError, OSError, ValueError):
                request({"command": "stop"}, timeout=10)
            shutil.rmtree(state_dir(), ignore_errors=True)
            remove_runtime_dir()
            remove_on_link()            # left by a daemon that didn't get to remove it
        if on != was:
            reload_panel()              # the phone button comes or goes
    elif key == "name":
        if value == DEFAULT_CHOICE:
            save_settings(name=None)
        elif clean_name(value):
            save_settings(name=clean_name(value))
        else:
            raise PhoneError("name: some letters or digits, or default")
        with contextlib.suppress(PhoneError, OSError, ValueError):
            request({"command": "reload"}, timeout=10)
    elif key == "networks":
        # NetworkManager connection UUIDs, separated by spaces; "" for none.
        networks = tuple(dict.fromkeys(value.split()))
        if value == DEFAULT_CHOICE:
            save_settings(networks=None)
        elif all(re.fullmatch(r"[0-9A-Za-z-]{1,64}", n) for n in networks):
            save_settings(networks=networks)
        else:
            raise PhoneError("networks: NetworkManager connection UUIDs, or default")
        with contextlib.suppress(PhoneError, OSError, ValueError):
            request({"command": "reload"}, timeout=10)
    return 0


def panel_status():
    """The panel button: connected, or dimmed while no phone is."""
    if not load_settings().enabled:
        return {"text": ""}             # waybar hides a module without text
    try:
        status = request({"command": "status"}, timeout=5)
    except (PhoneError, OSError, ValueError):
        status = None
    connected = [link for link in (status or {}).get("connected", []) if link["paired"]]
    if connected:
        state, text = "connected", "Connected to " + ", ".join(
            link["name"] + battery_text(link.get("battery")) for link in connected)
    elif status:
        state, text = "waiting", "No phone connected"
    else:
        state, text = "waiting", "The phone connection isn't running"
    return {"text": " ", "alt": state, "class": [state],
            "tooltip": f"{text}\nClick: send the clipboard, what came from the phone, settings"}


def battery_text(battery):
    """ · 80 %, charging: a phone's battery for the tooltip, or nothing."""
    if not battery:
        return ""
    charge, charging = battery
    return f" · {charge} %" + (", charging" if charging else "")


def menu_entries(connected, received, control, screenshot=True):
    """(label, action) for the button's menu: action is ("send-files",),
    ("send-text",), ("send-clipboard",), ("send-screenshot",), ("ring",),
    ("run", ARGV) or ("copy", TEXT)."""
    entries = []
    if connected:
        entries.append(("Send Files to Phone…", ("send-files",)))
        entries.append(("Send Text to Phone…", ("send-text",)))
        entries.append(("Send Clipboard to Phone", ("send-clipboard",)))
        if screenshot:              # grim is only a Recommends of flickos-desktop
            entries.append(("Send Screenshot to Phone", ("send-screenshot",)))
        entries.append(("Ring My Phone", ("ring",)))
    for item in reversed(received[-MENU_RECEIVED:]):
        kind, value = item.get("kind"), item.get("value", "")
        if kind == "page":
            entries.append((f"Open {short_address(value)}", ("run", ["xdg-open", value])))
        elif kind == "file" and os.path.isfile(value):
            if openable(value):
                entries.append((f"Open {os.path.basename(value)}", ("run", ["xdg-open", value])))
            else:
                entries.append((f"Show {os.path.basename(value)} in Folder",
                                ("run", ["xdg-open", os.path.dirname(value)])))
        elif kind in ("text", "clipboard") and value.strip():
            first = value.strip().splitlines()[0]
            first = first if len(first) <= 50 else first[:49] + "…"
            entries.append((f"Copy \u201c{first}\u201d", ("copy", value)))
    if control:
        entries.append(("Phone Settings", ("run", ["flickos-control", "--page", "phone"])))
    return entries


def cmd_menu(opts):
    """The panel button's menu, with fuzzel."""
    if shutil.which("fuzzel") is None:
        raise PhoneError("fuzzel is not installed")
    try:
        status = request({"command": "status"}, timeout=5) or {}
    except (PhoneError, OSError, ValueError):
        status = {}
    connected = [link["name"] for link in status.get("connected", []) if link["paired"]]
    entries = menu_entries(connected, read_received(), shutil.which("flickos-control") is not None,
                           shutil.which("grim") is not None)
    if not entries:
        return 0
    prompt = f"{connected[0]}: " if len(connected) == 1 else "Phone: "
    # --index: fuzzel answers with the entry's number (flick-tiler's menu does the same).
    result = subprocess.run(["fuzzel", "--dmenu", "--index", "--prompt", prompt, "--lines", str(len(entries))],
                            input="\n".join(label.replace("\n", " ") for label, _ in entries) + "\n",
                            capture_output=True, text=True, check=False)
    try:
        index = int(result.stdout.strip())
    except ValueError:
        return 0                        # nothing chosen
    if not 0 <= index < len(entries):
        return 0
    action = entries[index][1]
    sends = {"send-files": "choose", "send-text": "type_text", "send-clipboard": "clipboard",
             "send-screenshot": "screenshot"}
    if action[0] in sends:
        what = {flag: flag == sends[action[0]] for flag in sends.values()}
        return cmd_send(argparse.Namespace(things=[], to=None, text=None, notify=True, **what))
    if action[0] == "ring":
        return cmd_ring(argparse.Namespace(to=None, notify=True))
    if action[0] == "copy":
        copy_text(action[1])
    else:
        spawn(action[1])
    return 0


