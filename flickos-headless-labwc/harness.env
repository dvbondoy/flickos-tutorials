# harness.env: what every harness script shares. The scripts source it
# (". ./harness.env"); you can too, to use its functions in your shell.

HARNESS_DIR=$(cd "$(dirname "$0")" && pwd)

# Everything the harness makes lives under $HL, by default in your runtime
# folder (a tmpfs, emptied at logout). It must be a short path: a Wayland
# socket's full path must fit in 108 bytes.
HL=${HL:-${XDG_RUNTIME_DIR:-/tmp}/harness}
HL_RUN=$HL/run      # the harness's XDG_RUNTIME_DIR: Wayland and D-Bus sockets
HL_HOME=$HL/home    # a fresh home folder, so nothing touches your real one
HL_LOG=$HL/log      # what labwc and the session print

# The environment of everything in the harness, built from nothing (env -i)
# rather than from your session's: your terminal has LABWC_PID (so
# `labwc --reconfigure` would reload your real labwc), XDG_CONFIG_DIRS with
# your real layout overlay, DBUS_SESSION_BUS_ADDRESS of your real session
# bus, and more. Only these go in.
# With HARNESS_EXEC=exec, the calling (sub)shell becomes the program, so $!
# and $$ are the program's PID; a background function would otherwise be a
# subshell with the program as its child.
harness_env() {
    $HARNESS_EXEC env -i \
        PATH="$HARNESS_DIR/tools/usr/bin:/usr/local/bin:/usr/bin:/bin" \
        HOME="$HL_HOME" USER="$USER" LOGNAME="$USER" SHELL=/bin/sh \
        LANG="${LANG:-C.UTF-8}" TERM="${TERM:-xterm-256color}" \
        XDG_RUNTIME_DIR="$HL_RUN" \
        XDG_CONFIG_HOME="$HL_HOME/.config" XDG_DATA_HOME="$HL_HOME/.local/share" \
        XDG_STATE_HOME="$HL_HOME/.local/state" XDG_CACHE_HOME="$HL_HOME/.cache" \
        DBUS_SESSION_BUS_ADDRESS="unix:path=$HL_RUN/bus" \
        LD_LIBRARY_PATH="$HARNESS_DIR/tools/usr/lib/x86_64-linux-gnu" \
        "$@"
}

# PIDs (as your shell sees them) of the processes called NAME that belong
# to this harness: the ones whose environment has our XDG_RUNTIME_DIR. The
# same name may be running in your real session, so never pkill a name.
harness_pids() {
    # The kernel keeps only the first 15 characters of a process name, and
    # pgrep -x matches that: flickos-shortcuts is "flickos-shortcu".
    for p in $(pgrep -x "$(printf '%.15s' "$1")"); do
        # 2>/dev/null first: a failed <file is reported before later redirections apply.
        tr '\0' '\n' 2>/dev/null <"/proc/$p/environ" | grep -qx "XDG_RUNTIME_DIR=$HL_RUN" && echo "$p"
    done
}

harness_running() {
    [ -S "$HL_RUN/wayland-0" ] && [ -n "$(harness_pids labwc)" ]
}
